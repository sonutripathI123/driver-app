# ==============================================================================
# Enterprise Chauffeur Operations Platform — Environment Configuration Template
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Crown Chauffeurs Platform"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Secret Keys (Generate with `openssl rand -hex 32`)
JWT_SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Bootstrap Administrator Credentials
DEFAULT_ADMIN_EMAIL=admin@chauffeurplatform.com
DEFAULT_ADMIN_PASSWORD=AdminSecurePassword123!
DEFAULT_ADMIN_NAME="System Administrator"

# Database Configuration
# Local Development (SQLite Async):
DATABASE_URL=sqlite+aiosqlite:///./chauffeur_dev.db
# Production (PostgreSQL 16 Async):
# DATABASE_URL=postgresql+asyncpg://chauffeur_admin:ChauffeurDBSecret2026!@postgres:5432/chauffeur_platform

# Redis In-Memory Cache (Optional in dev, required in prod)
# REDIS_URL=redis://localhost:6379/0

# CORS Whitelist (JSON Array or Comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://app.crownchauffeurs.com.au"]

# Security, Rate Limiting & DoS Protection
ENABLE_SECURITY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_SIZE_BYTES=10485760

# External Third-Party API Integrations
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_chauffeur_2026
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret_2026
AEROAPI_KEY=mock_aeroapi_key_2026
GOOGLE_MAPS_API_KEY=mock_google_maps_api_key_2026

# Australian Business & Tax Defaults
DEFAULT_CURRENCY=AUD
DEFAULT_TIMEZONE=Australia/Melbourne
DEFAULT_GST_PERCENTAGE=10.0

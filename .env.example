# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env)
# Chauffeur Operations, Dispatch, Booking, Driver, Payment & CRM Platform
# ==============================================================================

# System Environment (development | staging | production | test)
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Chauffeur Operations Platform"
API_V1_STR="/api/v1"

# Application Host & Ports
HOST=0.0.0.0
PORT=8000

# Security & JWT Tokens
# Generate secret key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-encoded-key-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin Seed Credentials (for initial setup)
DEFAULT_ADMIN_EMAIL=admin@chauffeurplatform.com
DEFAULT_ADMIN_PASSWORD=AdminSecurePassword123!
DEFAULT_ADMIN_NAME="System Administrator"

# Database Configuration (PostgreSQL in production / aiosqlite fallback in test)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chauffeur_db
# Test Database URL (In-memory or isolated SQLite for unit testing)
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# CORS Settings (Comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Google Maps / Routing API
GOOGLE_MAPS_API_KEY=AIzaSyPlaceholder

# Email Integration (Resend / SendGrid / SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder
SENDGRID_API_KEY=SG.placeholder
EMAIL_FROM_ADDRESS=bookings@chauffeurplatform.com
EMAIL_FROM_NAME="Executive Chauffeur Services"

# SMS Integration (Twilio)
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Integration (WhatsApp Business Cloud API)
WHATSAPP_API_TOKEN=placeholder
WHATSAPP_PHONE_NUMBER_ID=placeholder
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder

# Flight Tracking API (AviationStack / FlightAware)
FLIGHT_TRACKING_PROVIDER=aviationstack
FLIGHT_API_KEY=placeholder

# Operations Dual-Alert Recipients
OPERATIONS_ALERT_EMAIL=ops@chauffeurplatform.com
OPERATIONS_ALERT_WHATSAPP=+61400000000

# Business Defaults
DEFAULT_CURRENCY=AUD
DEFAULT_TIMEZONE=Australia/Melbourne
DEFAULT_GST_PERCENTAGE=10.0
